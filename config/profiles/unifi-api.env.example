# Ambient Ops production configuration with the UniFi Network API fallback.
#
# Create it with: ./scripts/ambient-ops.sh init --profile unifi-api
# Keep the API key in ./secrets; do not paste it into this file.

AMBIENT_OPS_IMAGE=ghcr.io/gaofeng21cn/ambient-ops:0.1.21
SITE_NAME=Home Ambient Ops
DISPLAY_TIME_ZONE=Etc/UTC
INSTANCE_ID=replace-me
AMBIENT_OPS_NETWORK_MODE=unifi-api

UNIFI_BASE_URL=
UNIFI_SITE=default
UNIFI_ALLOW_SELF_SIGNED=false

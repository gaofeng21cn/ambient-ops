# Host port for the base Compose file. The container listens on TCP/8787.
AMBIENT_OPS_PORT=8787
# Pin a published multi-platform release. Change this only during a reviewed
# upgrade or rollback; do not deploy the moving `latest` tag in production.
AMBIENT_OPS_IMAGE=ghcr.io/gaofeng21cn/ambient-ops:0.1.1
DEMO_MODE=true
SITE_NAME=Ambient Ops
DISPLAY_TIME_ZONE=Asia/Shanghai
# Keep discovery off for demo/staging. compose.host-network.yaml enables it.
DISCOVERY_ENABLED=false
# Set a stable DNS-SD-safe ID before the first production start.
# Preserve it across upgrades and host migrations; clients remember this ID.
INSTANCE_ID=
# Compose reads secrets from ignored files under ./secrets:
#   agent_push_token (copy the exact value into each Codex TPS Mac Keychain)
#   unifi_snmp_auth_password
#   unifi_snmp_priv_password
# Optional fallbacks:
#   unifi_api_key
#   ha_token
UNIFI_BASE_URL=
UNIFI_SITE=default
UNIFI_ALLOW_SELF_SIGNED=false
UNIFI_CA_FILE=
UNIFI_POLL_MS=250
UNIFI_RATE_WINDOW_MS=2000
# Historical UNIFI_ prefix: the SNMP collector also works with a non-UniFi
# router only when SNMPv3 authPriv over IPv4 and IF-MIB Counter64 are verified.
UNIFI_SNMP_HOST=
UNIFI_SNMP_PORT=161
UNIFI_SNMP_USER=
UNIFI_SNMP_AUTH_PROTOCOL=sha
UNIFI_SNMP_PRIV_PROTOCOL=aes
# Exact case-insensitive IF-MIB index, ifName, or ifAlias; comma-separated for
# distinct multi-WAN uplinks. Never select stacked layers counting the same flow.
UNIFI_SNMP_INTERFACES=
UNIFI_SNMP_TIMEOUT_MS=3000
LIVE_AFTER_SECONDS=30
STALE_AFTER_SECONDS=300
HA_ENABLED=false
HA_BASE_URL=
HA_ENTITY_PREFIX=ambient_ops
HA_SYNC_MS=30000
HA_TIMEOUT_MS=5000

# Ambient Ops production configuration
#
# Copy this file to .env, or run ./scripts/ambient-ops.sh init. Secrets belong
# in ./secrets and must never be pasted into this file.

# Keep a reviewed version tag or digest. Do not use latest in production.
AMBIENT_OPS_IMAGE=ghcr.io/gaofeng21cn/ambient-ops:0.1.4
AMBIENT_OPS_PORT=8787

# Installation identity. The setup helper replaces replace-me with a stable ID.
# Preserve INSTANCE_ID when upgrading or moving the service.
SITE_NAME=Home Ambient Ops
DISPLAY_TIME_ZONE=Etc/UTC
INSTANCE_ID=replace-me

# Production is live data, never the synthetic demo.
DEMO_MODE=false
# The base Compose file keeps discovery off for staging. The host-network
# production override enables it on the physical LAN.
DISCOVERY_ENABLED=false

# Windows Codex TPS v0.2.9+ uses per-device signing after one visible approval.
DEVICE_PAIRING_ENABLED=true

# Setup validation profile: codex-only, snmpv3, or unifi-api.
# This key is consumed by scripts/ambient-ops.sh; the server infers enabled
# collectors from the values below.
AMBIENT_OPS_NETWORK_MODE=codex-only

# SNMPv3 profile. Fill these only when AMBIENT_OPS_NETWORK_MODE=snmpv3.
# Historical UNIFI_ names work with any qualified IF-MIB Counter64 router.
UNIFI_SNMP_HOST=
UNIFI_SNMP_USER=
UNIFI_SNMP_INTERFACES=
UNIFI_SNMP_PORT=161
UNIFI_SNMP_AUTH_PROTOCOL=sha
UNIFI_SNMP_PRIV_PROTOCOL=aes
UNIFI_SNMP_TIMEOUT_MS=3000
UNIFI_POLL_MS=250
UNIFI_RATE_WINDOW_MS=2000

# Optional UniFi Network API fallback. Fill these only when
# AMBIENT_OPS_NETWORK_MODE=unifi-api; put the API key in secrets/unifi_api_key.
UNIFI_BASE_URL=
UNIFI_SITE=default
UNIFI_ALLOW_SELF_SIGNED=false
UNIFI_CA_FILE=

# Machine freshness and optional Home Assistant bridge.
LIVE_AFTER_SECONDS=30
STALE_AFTER_SECONDS=300
HA_ENABLED=false
HA_BASE_URL=
HA_ENTITY_PREFIX=ambient_ops
HA_SYNC_MS=30000
HA_TIMEOUT_MS=5000

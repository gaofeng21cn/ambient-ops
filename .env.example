PORT=8787
DATA_DIR=/data
DEMO_MODE=true
SITE_NAME=Ambient Ops
DISPLAY_TIME_ZONE=Asia/Shanghai
DISCOVERY_ENABLED=true
INSTANCE_ID=
# Put secrets in ignored files under ./secrets:
# agent_push_token, unifi_api_key, unifi_snmp_auth_password,
# unifi_snmp_priv_password, ha_token
UNIFI_BASE_URL=https://gateway.example.lan
UNIFI_SITE=default
UNIFI_ALLOW_SELF_SIGNED=false
UNIFI_CA_FILE=
UNIFI_POLL_MS=250
UNIFI_RATE_WINDOW_MS=2000
UNIFI_SNMP_HOST=
UNIFI_SNMP_PORT=161
UNIFI_SNMP_USER=
UNIFI_SNMP_AUTH_PROTOCOL=sha
UNIFI_SNMP_PRIV_PROTOCOL=aes
UNIFI_SNMP_INTERFACES=
UNIFI_SNMP_TIMEOUT_MS=3000
LIVE_AFTER_SECONDS=30
STALE_AFTER_SECONDS=300
HA_ENABLED=false
HA_BASE_URL=http://home-assistant.example.lan:8123
HA_TOKEN=
HA_ENTITY_PREFIX=ambient_ops
HA_SYNC_MS=30000
HA_TIMEOUT_MS=5000

#!/bin/sh

set -eu

umask 077
PATH=/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin
export PATH

PROGRAM=opl-nas-audit
JQ_BIN=/usr/bin/jq
SYNO_WEBAPI_BIN=/usr/syno/bin/synowebapi
PROC_STAT_FILE=/proc/stat

TEST_ROOT=${OPL_NAS_AUDIT_TEST_ROOT:-}
if [ -n "$TEST_ROOT" ]; then
  if [ "$(id -u)" -eq 0 ]; then
    printf '%s\n' "$PROGRAM: test mode is disabled for root" >&2
    exit 77
  fi
  JQ_BIN=${OPL_NAS_AUDIT_TEST_JQ:-/opt/homebrew/bin/jq}
  SYNO_WEBAPI_BIN=$TEST_ROOT/bin/synowebapi
  PROC_STAT_FILE=$TEST_ROOT/proc-stat
  NOW_EPOCH=${OPL_NAS_AUDIT_TEST_NOW_EPOCH:-0}
else
  NOW_EPOCH=$(date +%s)
fi

fail() {
  printf '%s\n' "$PROGRAM: $*" >&2
  exit 1
}

usage() {
  cat <<'EOF'
Usage:
  opl-nas-audit status
EOF
}

require_executable() {
  [ -x "$1" ] || fail "required executable is missing: $1"
}

require_root() {
  [ "$(id -u)" -eq 0 ] || fail "must run as root through the approved sudo rule"
}

webapi() {
  if [ -n "$TEST_ROOT" ]; then
    env -i \
      PATH="$PATH" \
      OPL_NAS_AUDIT_TEST_ROOT="$TEST_ROOT" \
      "$SYNO_WEBAPI_BIN" "$@"
  else
    env -i PATH="$PATH" HOME=/root "$SYNO_WEBAPI_BIN" "$@"
  fi
}

task_status() {
  task_id=$1
  webapi --exec \
    api=SYNO.Backup.Task \
    version=1 \
    method=status \
    task_id="$task_id" \
    'additional=["last_bkp_success_time","last_bkp_time","last_bkp_result"]'
}

nas_status() {
  require_executable "$JQ_BIN"
  require_executable "$SYNO_WEBAPI_BIN"

  task_list=$(
    webapi --exec \
      api=SYNO.Backup.Task \
      version=1 \
      method=list \
      sort_by=name \
      'additional=["last_bkp_time","last_bkp_result"]'
  )
  printf '%s\n' "$task_list" | "$JQ_BIN" -e '.success == true' >/dev/null ||
    fail "Hyper Backup task list is unavailable"

  task_ids=$(
    printf '%s\n' "$task_list" | "$JQ_BIN" -r '
      [
        ..
        | objects
        | select(has("task_id") and has("last_bkp_result"))
        | .task_id
      ]
      | unique[]
    '
  )

  task_summaries=
  for task_id in $task_ids; do
    status=$(task_status "$task_id")
    printf '%s\n' "$status" | "$JQ_BIN" -e '.success == true' >/dev/null ||
      fail "Hyper Backup task status is unavailable"
    safe_summary=$(
      printf '%s\n' "$status" | "$JQ_BIN" -c '
        def epoch_seconds:
          if type != "number" then null
          elif . > 20000000000 then (. / 1000 | floor)
          else floor
          end;
        [
          ..
          | objects
          | select(has("last_bkp_result"))
          | {
              lastResult: (.last_bkp_result // "unknown"),
              successEpoch: (
                (
                  .last_bkp_success_time
                    // (if .last_bkp_result == "success" then .last_bkp_time else null end)
                )
                | epoch_seconds
              )
            }
        ]
        | first
        // {lastResult: "unknown", successEpoch: null}
      '
    )
    if [ -n "$task_summaries" ]; then
      task_summaries="$task_summaries
$safe_summary"
    else
      task_summaries=$safe_summary
    fi
  done

  if [ -n "$task_summaries" ]; then
    # shellcheck disable=SC2016
    hyper_backup=$(
      printf '%s\n' "$task_summaries" | "$JQ_BIN" -s \
        --argjson now "$NOW_EPOCH" '
          (map(select(.successEpoch != null)) | max_by(.successEpoch) | .successEpoch) as $latest
          | {
              configured: (length > 0),
              taskCount: length,
              tasksWithRecordedSuccess: (map(select(.successEpoch != null)) | length),
              latestSuccessEpoch: $latest,
              latestSuccessAt: (if $latest == null then null else ($latest | todateiso8601) end),
              latestSuccessAgeSeconds: (if $latest == null then null else ($now - $latest) end),
              status: (if $latest == null then "no_success_record" else "observed" end),
              lastResults: (
                group_by(.lastResult)
                | map({key: .[0].lastResult, value: length})
                | from_entries
              )
            }
        '
    )
  else
    hyper_backup='{"configured":false,"taskCount":0,"tasksWithRecordedSuccess":0,"latestSuccessEpoch":null,"latestSuccessAt":null,"latestSuccessAgeSeconds":null,"status":"not_configured","lastResults":{}}'
  fi

  host_boot_epoch=$(awk '$1 == "btime" { print $2; exit }' "$PROC_STAT_FILE")
  printf '%s\n' "$host_boot_epoch" | grep -E '^[0-9]+$' >/dev/null ||
    fail "host boot time is unavailable"

  result=$(
    # shellcheck disable=SC2016
    "$JQ_BIN" -n \
      --arg schema "opl_nas_audit.v1" \
      --arg scope "synology-host" \
      --argjson observedAtEpoch "$NOW_EPOCH" \
      --argjson hostBootEpoch "$host_boot_epoch" \
      --argjson hyperBackup "$hyper_backup" '
        {
          schema: $schema,
          scope: $scope,
          ok: true,
          attentionRequired: ($hyperBackup.status != "observed"),
          observedAtEpoch: $observedAtEpoch,
          host: {
            bootEpoch: $hostBootEpoch
          },
          hyperBackup: $hyperBackup
        }
      '
  )

  printf '%s\n' "$result"
}

if [ -z "$TEST_ROOT" ]; then
  require_root
fi

case ${1:-} in
  status)
    [ "$#" -eq 1 ] || {
      usage >&2
      exit 64
    }
    nas_status
    ;;
  -h|--help)
    usage
    ;;
  *)
    usage >&2
    exit 64
    ;;
esac
